# Backend settings for e2e runs that are the same every time. No real secrets: the JWT key is test-only.
# The database, ports and CORS origin are chosen per run by scripts/e2e-env.mjs (a throwaway ticketflow_e2e_* database
# and two free ports); the real database is never used.
JWT_SECRET=e2e-only-signing-key-not-used-anywhere-else-7f3a9c2e
JWT_EXPIRES_IN=1d
