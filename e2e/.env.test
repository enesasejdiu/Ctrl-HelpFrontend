# Backend config for e2e runs only. Loaded by scripts/e2e-backend.mjs (via DOTENV_PATH), never the backend's .env.
# No real secrets: the database is a throwaway server started just for the tests, and the JWT key is test-only.

# Backend API port for e2e (dev uses 5050)
PORT=4001

# Throwaway test database server (dev uses 3306); the reset script refuses to run unless DB_NAME contains "test"
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=ticketflow_test

JWT_SECRET=e2e-only-signing-key-not-used-anywhere-else-7f3a9c2e
JWT_EXPIRES_IN=1d

# The e2e frontend (dev uses 5173). Also the CORS origin the backend allows.
CLIENT_URL=http://localhost:5174
