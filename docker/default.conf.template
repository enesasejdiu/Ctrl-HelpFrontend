# nginx site for the TicketFlow frontend image (Dockerfile; README "Docker").
# A template: when the container starts, nginx's entrypoint replaces ${BACKEND_URL} and ${NGINX_LOCAL_RESOLVERS} with
# their values and writes the result to /etc/nginx/conf.d/default.conf. nginx's own $variables are left alone.

# Referrer-Policy (security-headers.conf): no-referrer on the two password pages, so the one-time link's token or the
# typed email address can never leave in a Referer; strict-origin-when-cross-origin everywhere else. By the request
# as it came in ($request_uri), because the page itself is answered from /index.html.
map $request_uri $referrer_policy {
    default "strict-origin-when-cross-origin";
    ~^/(set|forgot)-password(/|\?|$) "no-referrer";
    ~^/api/ "";
}

# The other security headers (security-headers.conf) are for this image's own answers: the page and its files. The
# API sends its own, stricter ones (helmet: Content-Security-Policy default-src 'none', no-referrer, ...), and the
# /api/ location inherits the server's add_header lines, so without this every API answer had each header twice
# ("X-Content-Type-Options: nosniff, nosniff", two CSPs). An empty value means nginx doesn't add the header at all.
map $request_uri $page_csp {
    ~^/api/ "";
    default "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.sentry.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
}
map $request_uri $page_nosniff {
    ~^/api/ "";
    default "nosniff";
}
map $request_uri $page_frame_options {
    ~^/api/ "";
    default "DENY";
}
map $request_uri $page_permissions_policy {
    ~^/api/ "";
    default "camera=(), microphone=(), geolocation=()";
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;

    # Don't say which nginx version this is
    server_tokens off;

    # Attachments are 10 MB at most and the app uploads them one file per request (src/api/attachments.js), so 11 MB
    # leaves room for the multipart overhead. Anything bigger is refused here (413) before it reaches the API. The
    # backend still checks the real limits (and would take up to 5 files in one request from other clients).
    client_max_body_size 11m;

    # Compress text answers (text/html always is). No gzip_static: the Vite build doesn't write .gz files.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # The security headers. Repeated (include) in every location that adds a header of its own, because nginx drops
    # the server's add_header lines in any location that has its own.
    include /etc/nginx/snippets/security-headers.conf;

    # ^~ on /assets/ and /api/: these prefixes win over the "file extension" rule further down, so /api/x.json still
    # reaches the API.

    # Built files have a content hash in their name, so a file never changes: cache it for good. A missing one is a
    # real 404, never index.html (README "Hosting").
    location ^~ /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # For the container's health check; not logged
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API, on the same origin as the page, so the session cookies are first-party and the page can read tf_csrf
    # (README "Sessions"). Cookies and the X-CSRF-Token header pass through unchanged (nginx forwards every request
    # header and Set-Cookie). The backend's address is looked up per request (resolver), so nginx starts even when the
    # API isn't up yet and finds it again after it restarts with a new address. Never falls back to index.html: an
    # unknown API route gets the backend's own 404 JSON. Nothing here is cached by nginx (there is no proxy_cache).
    location ^~ /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $api_url ${BACKEND_URL};
        # The /api prefix is KEPT: the backend's routes are /api/... (app.js, routes/index.js). proxy_pass with a
        # variable and no path passes the request on exactly as it came in, query string included. (Writing a path
        # here, e.g. ${BACKEND_URL}/, would cut /api off.)
        proxy_pass $api_url;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Uploads stream straight to the API instead of being written to a temporary file first
        proxy_request_buffering off;
        # A backend that doesn't answer the connection within 5 s is down (502 straight away); requests themselves
        # (uploads included) get a minute. No websockets or server-sent events in the app, so no upgrade headers.
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Anything else with a file extension (favicon.svg from public/, robots.txt, …): the file or a real 404, never
    # index.html, so a missing file can't come back as HTML. These names have no hash, so they may change with a
    # deploy: cached for an hour only.
    location ~ \.[a-zA-Z0-9]+$ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # Every page address (/tickets, /tickets/42, /admin/users?page=2, a reload, a mistyped one): the app, which then
    # shows the page or its own "not found". (No $uri/: the build has no folders to serve an index from.)
    location / {
        try_files $uri /index.html;
    }

    # The app's page itself (also where "location /" ends up). no-cache: the browser may keep it but asks every time
    # (ETag / If-None-Match, a cheap 304 when nothing changed), so after a deploy it gets the new page, and with it the
    # new /assets/ names, without a hard refresh. No service worker in the app, so nothing else needs this.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
}
