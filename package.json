{
  "name": "ticketflow-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:repeat": "node scripts/repeat-tests.mjs 3",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:temporary-passwords": "node scripts/e2e-temporary-passwords.mjs",
    "e2e:staging": "playwright test --config playwright.staging.config.ts",
    "e2e:deployed": "playwright test --config playwright.deployed.config.ts",
    "e2e:cleanup": "node scripts/e2e-backend.mjs cleanup"
  },
  "dependencies": {
    "@sentry/react": "^11.12.0",
    "axios": "^1.21.1",
    "dompurify": "^3.4.18",
    "lucide-react": "^1.72.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
