# Base URL of the backend API, as the browser calls it.
# /api goes through the dev server's proxy (vite.config.js), so the page and the API share one origin: the session
# cookies are first-party and the page can read the CSRF cookie. Keep it that way in production too (serve the API
# under the same origin, e.g. a reverse proxy for /api); see "Sessions" in README.md.
VITE_API_URL=/api

# Where the dev server's /api proxy forwards to (your local backend). Not part of the app bundle.
API_PROXY_TARGET=http://localhost:5050

# Error monitoring (optional). With a Sentry DSN, crashes and unhandled errors are reported to Sentry; without one,
# Sentry isn't even downloaded and errors only go to the browser console. See "When something crashes" in README.md.
VITE_SENTRY_DSN=
# Shown in Sentry to tell deployments apart; defaults to the Vite mode (development / production)
VITE_SENTRY_ENVIRONMENT=
# The build's version, e.g. the git commit, so Sentry can tell which deploy an error came from
VITE_SENTRY_RELEASE=
